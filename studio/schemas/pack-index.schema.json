{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "events/index.json / collections/index.json",
  "description": "活动与图集共用 schema：条目具备封面 + ZIP 包，id 与 coverUrl/zipUrl/zipKey 文件名校验强关联。",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "enum": [
        "events",
        "collections"
      ]
    },
    "version": {
      "$ref": "common.schema.json#/$defs/positiveInt"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packEntry"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "module",
    "version",
    "updatedAt",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "packEntry": {
      "type": "object",
      "title": "活动/图集条目",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(event|collection)-[a-z0-9-]+-\\d{3}$"
        },
        "type": {
          "const": "zip"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string"
        },
        "status": {
          "const": "active"
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 1
        },
        "coverUrl": {
          "type": "string",
          "pattern": "^covers/(event|collection)-[a-z0-9-]+-\\d{3}\\.webp$"
        },
        "zipUrl": {
          "type": "string",
          "pattern": "^packs/(event|collection)-[a-z0-9-]+-\\d{3}\\.zip$"
        },
        "fileSizeBytes": {
          "$ref": "common.schema.json#/$defs/nonNegativeInt"
        },
        "zipSha256": {
          "$ref": "common.schema.json#/$defs/hash64"
        },
        "totalCount": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "titleZh": {
          "type": "string",
          "minLength": 1
        },
        "zipKey": {
          "type": "string",
          "pattern": "^(events|collections)/packs/(event|collection)-[a-z0-9-]+-\\d{3}\\.zip$"
        },
        "zipUrls": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/absUrl"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "desc",
        "status",
        "displayOrder",
        "coverUrl",
        "zipUrl",
        "fileSizeBytes",
        "zipSha256",
        "totalCount",
        "revision",
        "createdAt",
        "updatedAt",
        "titleZh",
        "zipKey",
        "zipUrls"
      ],
      "additionalProperties": false
    }
  }
}